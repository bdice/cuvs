diff --git a/.github/workflows/pr.yaml b/.github/workflows/pr.yaml
index 0ad4de8e..1ff5ee62 100644
--- a/.github/workflows/pr.yaml
+++ b/.github/workflows/pr.yaml
@@ -497,7 +497,9 @@ jobs:
       build_type: pull-request
       script: "ci/test_cpp.sh ${{ matrix.shard }} ${{ matrix.num_shards }}"
       cache-paths: .cache/cuda-jit
-      cache-key-prefix: libcuvs-cudajit-v1
+      # One cache per test shard: each shard links a different set of kernels, and with a shared key
+      # only the first shard to finish could save its archive.
+      cache-key-prefix: libcuvs-cudajit-v1-shard${{ matrix.shard }}of${{ matrix.num_shards }}
       # Caches are immutable. Re-key when the JIT-relevant sources change so a completed run can
       # save newly compiled entries; restore a compatible earlier archive first.
       cache-key-files: |
