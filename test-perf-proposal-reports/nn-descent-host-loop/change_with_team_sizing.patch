+// The host-side loops over graph rows (sample_graph, sample_graph_new, update_graph, sort_lists,
+// the output copies, ...) cost roughly 0.1-2 us per row on one core, while forking and joining a
+// full OpenMP team costs from a few us (hot team) to milliseconds (oversubscribed host). Give each
+// thread at least MIN_ROWS_PER_OMP_THREAD rows so that small graphs (CAGRA/HNSW-ACE partitions,
+// upper HNSW layers, tests) don't wake every core for a few hundred microseconds of work. Graphs
+// with MIN_ROWS_PER_OMP_THREAD * omp_get_max_threads() rows or more still use the whole team.
+constexpr size_t MIN_ROWS_PER_OMP_THREAD = 256;
+
+inline int omp_threads_for_rows(size_t nrow)
+{
+  const auto max_threads = static_cast<size_t>(std::max(1, cuvs::core::omp::get_max_threads()));
+  return static_cast<int>(std::clamp<size_t>(nrow / MIN_ROWS_PER_OMP_THREAD, 1, max_threads));
+}
